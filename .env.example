# Режим работы задаётся явно. Пустой токен режим НЕ переключает.
#   prod — боевой: вход только через подписанный initData из MAX, данные только реальные.
#   demo — витрина с выдуманными учениками, своя база (school_hero_demo.db). Только локально.
APP_MODE=prod

# Токен бота из business.max.ru → Чат-боты → нужный бот → Настройки. Обязателен для prod.
MAX_BOT_TOKEN=

# Максимальный возраст initData в секундах.
INIT_DATA_MAX_AGE=3600

# MAX user id через запятую.
TEACHER_MAX_IDS=
DIRECTOR_MAX_IDS=

# Школы и классы (prod) — файл по образцу catalog.example.json.
# CATALOG_FILE=data/catalog.json

# Класс, в который попадает пользователь до выбора своего (должен быть в каталоге).
# DEFAULT_CLASS_ID=1  # только для демо; в prod класс выбирается при регистрации

# Регистрация школ директорами: auto - школа видна сразу, manual - после подтверждения
SCHOOL_APPROVAL=auto
# MAX id администраторов платформы (подтверждают школы при SCHOOL_APPROVAL=manual)
PLATFORM_ADMIN_MAX_IDS=

HOST=127.0.0.1
PORT=8000
SERVE_FRONTEND=true
