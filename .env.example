# Токен бота из business.max.ru → Чат-боты → нужный бот → ⋮ → Настройки.
# Пока переменная пуста, приложение работает в демо-режиме с подписью «Демо».
MAX_BOT_TOKEN=

# Максимальный возраст initData в секундах (рекомендуется 3600).
INIT_DATA_MAX_AGE=3600

# MAX user id педагогов через запятую. Им доступен кабинет педагога.
TEACHER_MAX_IDS=

# Класс, в который попадают новые ученики после онбординга.
DEFAULT_CLASS_ID=1

# Домен для docker compose с профилем proxy (Caddy + HTTPS), без https://.
# APP_DOMAIN=school-hero.example.ru

# Для локального запуска. В Docker compose HOST и PORT задаются автоматически.
HOST=127.0.0.1
PORT=8000

# Раздавать собранный frontend через FastAPI. Для разработки оставьте false:
# сайт будет работать на http://127.0.0.1:5173.
SERVE_FRONTEND=false
