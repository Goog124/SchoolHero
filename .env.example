# Образец .env. Скопируйте в .env и заполните. Реальные значения сюда не пишите:
# этот файл лежит в git.

# Режим работы задаётся явно. Пустой токен режим НЕ переключает.
#   prod    — боевой: вход только через подписанный initData из MAX, данные только реальные.
#   demo    — витрина с выдуманными учениками, своя база (school_hero_demo.db). Только локально.
#   sandbox — локальная проверка регистрации школы без MAX, только loopback.
# На сервере допустим только prod (deploy/*.sh откажутся работать с другим значением,
# systemd-юнит и docker-compose всё равно принудительно ставят prod).
APP_MODE=prod

# Токен бота из business.max.ru → Чат-боты → нужный бот → Настройки. Обязателен для prod.
MAX_BOT_TOKEN=

# Максимальный возраст initData в секундах, допустимо 60..86400.
# Меньше — короче окно для повторного использования перехваченных данных,
# но пользователю чаще придётся заново открывать приложение. 86400 = сутки.
INIT_DATA_MAX_AGE=86400

# MAX user id через запятую.
TEACHER_MAX_IDS=
DIRECTOR_MAX_IDS=

# Школы и классы (prod) — файл по образцу catalog.example.json.
# CATALOG_FILE=data/catalog.json

# Класс, в который попадает пользователь до выбора своего (должен быть в каталоге).
# DEFAULT_CLASS_ID=1  # только для демо; в prod класс выбирается при регистрации

# Регистрация школ директорами:
#   auto   — школа видна и работает сразу после регистрации. Любой пользователь MAX
#            может назваться директором и создать «школу»; подходит для локальной
#            проверки и закрытых пилотов.
#   manual — школа работает только после подтверждения администратором платформы
#            (PLATFORM_ADMIN_MAX_IDS). Рекомендуется для боевого сервера.
# При manual обязательно заполните PLATFORM_ADMIN_MAX_IDS, иначе подтверждать будет некому.
SCHOOL_APPROVAL=auto
# MAX id администраторов платформы через запятую (подтверждают школы при SCHOOL_APPROVAL=manual).
PLATFORM_ADMIN_MAX_IDS=
# Первый пользователь MAX, вошедший в ПУСТУЮ базу (prod), становится администратором платформы.
# Риск: если приложение первым откроет посторонний, админом станет он. После выкладки откройте
# приложение первым сами или заполните PLATFORM_ADMIN_MAX_IDS (тогда это правило не действует).
# 0 - выключить.
BOOTSTRAP_FIRST_ADMIN=1

HOST=127.0.0.1
PORT=8000
SERVE_FRONTEND=true

# --- Бот MAX (приветствие и кнопка мини-приложения), см. docs/bot.md ---
# Секрет webhook: не короче 32 символов, только [A-Za-z0-9_-] (до 256).
# Пусто — webhook в prod отвечает 403 (бот не принимает сообщения).
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
# или его сгенерирует и покажет `python tools/max_bot.py subscribe`.
MAX_WEBHOOK_SECRET=
# Username бота без @. Пусто - берётся из GET /me и кэшируется.
# MAX_BOT_USERNAME=
# Публичный адрес приложения (webhook = PUBLIC_URL/api/max/webhook). Также принимается MINIAPP_URL.
# PUBLIC_URL=https://app.example.org
# MAX_API_BASE=https://platform-api2.max.ru
# Файл с доверенными сертификатами (PEM), если системное хранилище не содержит сертификат Минцифры.
# MAX_CA_BUNDLE=
# Не чаще одного ответа на сообщения пользователя за N секунд.
# BOT_REPLY_INTERVAL=60

# --- Только для docker compose --profile proxy (Caddy) ---
# Домен без https://
# APP_DOMAIN=app.example.org
