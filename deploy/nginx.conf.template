# nginx: __DOMAIN__ -> School Hero (127.0.0.1:8000), сертификаты Let's Encrypt.
# Шаблон: __DOMAIN__ подставляется скриптами deploy.sh и deploy-docker.sh.
# Ставится в /etc/nginx/conf.d/__DOMAIN__.conf, то есть внутрь блока http {}.
#
# default_server здесь намеренно не задаётся: на сервере могут быть другие сайты.
# Рекомендация по «серверу-заглушке» для чужих имён — docs/deploy.md.

# Ограничение частоты запросов к /api/ (один IP). Директива допустима только в
# контексте http — файлы conf.d подключаются именно туда. Имя зоны уникально
# для проекта; на сервере должна быть только одна копия этого конфига.
limit_req_zone $binary_remote_addr zone=school_hero_api:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __DOMAIN__;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Заголовки безопасности. X-Frame-Options не ставим: веб-версия MAX может
    # открывать мини-приложение во фрейме.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Под загрузку фото до 5 МБ (с запасом на multipart); без загрузки фото хватило бы 2m.
    client_max_body_size 6m;
    client_body_timeout  15s;
    client_header_timeout 15s;
    send_timeout         30s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Общие параметры проксирования (наследуются обоими location).
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;
    # Если приложение само ставит эти заголовки, не дублируем их.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;

    # API: 10 запросов/с с одного IP, всплеск до 40 (старт мини-приложения
    # делает несколько запросов сразу). Сверх лимита — 429.
    location /api/ {
        limit_req zone=school_hero_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
